<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.simplet1me.companyrestaurant.mapper.RecipeMapper">

    <resultMap id="recipeMap" type="com.simplet1me.companyrestaurant.entity.Recipe">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="photo" property="photo"/>
        <result column="unit" property="unit"/>
        <result column="classify" property="classify"/>
        <result column="price" property="price"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="baseColumns">
        id, name, photo, unit, classify, price, create_time, update_time
    </sql>

    <select id="pageList" resultMap="recipeMap">
        SELECT <include refid="baseColumns"/>
        FROM recipe
        <where>
            <if test="keyword != null and keyword != ''">
                AND name LIKE CONCAT('%', #{keyword}, '%')
            </if>
            <if test="classify != null and classify != ''">
                AND classify = #{classify}
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="countByCond" resultType="long">
        SELECT COUNT(*)
        FROM recipe
        <where>
            <if test="keyword != null and keyword != ''">
                AND name LIKE CONCAT('%', #{keyword}, '%')
            </if>
            <if test="classify != null and classify != ''">
                AND classify = #{classify}
            </if>
        </where>
    </select>

    <select id="findById" resultMap="recipeMap">
        SELECT <include refid="baseColumns"/>
        FROM recipe
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.simplet1me.companyrestaurant.entity.Recipe"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO recipe (name, photo, unit, classify, price)
        VALUES (#{name}, #{photo}, #{unit}, #{classify}, #{price})
    </insert>

    <update id="update" parameterType="com.simplet1me.companyrestaurant.entity.Recipe">
        UPDATE recipe
        SET name = #{name}, photo = #{photo}, unit = #{unit},
            classify = #{classify}, price = #{price}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM recipe WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM recipe WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
